rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isParent() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }
    function isParentDragonId(dragonId) {
      return dragonId in ['thunder-mother', 'frost-queen', 'embers-lord', 'ancestor-of-woods', 'star-sea-oracle'];
    }
    function isLinkedParent(childId) {
      return isParent()
        && exists(/databases/$(database)/documents/parentLinks/$(childId))
        && get(/databases/$(database)/documents/parentLinks/$(childId)).data.parentId == request.auth.uid
        && get(/databases/$(database)/documents/parentLinks/$(childId)).data.status == 'approved';
    }

    match /users/{userId} {
      // 家长可读取儿童的基础资料，供首次选择关联对象；关联后才能读取详细学习资料。
      allow read: if isOwner(userId) || isAdmin()
        || (isParent() && resource.data.role == 'child');
      allow create, update, delete: if false;
      match /dragon/{dragonId} {
        function validEnergy(data) {
          return !data.keys().hasAny(['energy'])
            || (data.energy is int && data.energy >= 0 && data.energy <= 10);
        }
        function validInitialEnergy(data) {
          let linkedAttempt = getAfter(/databases/$(database)/documents/users/$(userId)/attempts/$(data.energyAssessmentId));
          return data.keys().hasAll(['energy', 'energyAssessmentId'])
            && data.energy is int && data.energy >= 0 && data.energy <= 10
            && data.energyAssessmentId is string
            && linkedAttempt.data.type == 'initial-assessment'
            && linkedAttempt.data.eggId == data.eggId
            && linkedAttempt.data.score == data.energy
            && linkedAttempt.data.answers.size() == 10;
        }
        function validEnergyTransition() {
          let energyChanged = request.resource.data.diff(resource.data).affectedKeys().hasAny(['energy']);
          return !energyChanged || (validEnergy(request.resource.data)
            && ((!resource.data.keys().hasAny(['energy']) && request.resource.data.energy == 0)
              || (resource.data.keys().hasAny(['energy'])
                // 充能每次最多 +1；技能可以扣除任意点数，但不能扣到负数。
                && (request.resource.data.energy == resource.data.energy + 1
                  || request.resource.data.energy < resource.data.energy))));
        }
        allow read: if isOwner(userId) || isAdmin() || isLinkedParent(userId);
        allow create: if isAdmin() || (isOwner(userId)
          && !request.resource.data.keys().hasAny(['checkinEpoch'])
          && validEnergy(request.resource.data)
          && validInitialEnergy(request.resource.data));
        allow update: if isAdmin() || (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['checkinEpoch'])
          && validEnergyTransition());
        allow delete: if isAdmin();
      }
      match /progress/{progressId} {
        function canEditAssessment() {
          return progressId == 'summary' && isAdmin()
            && get(/databases/$(database)/documents/users/$(userId)).data.role == 'child';
        }
        function assessmentFields() {
          return ['chineseLevel', 'englishLevel', 'mathLevel', 'totalCorrect', 'totalAnswered'];
        }
        function validAssessmentLevels(data) {
          return data.chineseLevel is int && data.chineseLevel >= 1 && data.chineseLevel <= 3
            && data.englishLevel is int && data.englishLevel >= 3 && data.englishLevel <= 5
            && data.mathLevel is int && data.mathLevel >= 3 && data.mathLevel <= 5;
        }
        function validAssessmentTotals(data) {
          return data.totalCorrect is int && data.totalAnswered is int
            && data.totalCorrect >= 0 && data.totalCorrect <= data.totalAnswered;
        }
        allow read: if isOwner(userId) || isAdmin() || isLinkedParent(userId);
        allow create, update: if isOwner(userId);
        allow create: if canEditAssessment()
          && request.resource.data.keys().hasOnly(assessmentFields())
          && validAssessmentLevels(request.resource.data)
          && (!request.resource.data.keys().hasAny(['totalCorrect', 'totalAnswered'])
            || validAssessmentTotals(request.resource.data));
        allow update: if canEditAssessment()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(assessmentFields())
          && validAssessmentLevels(request.resource.data)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalCorrect', 'totalAnswered'])
            || validAssessmentTotals(request.resource.data));
        allow delete: if isAdmin();
      }
      match /attempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin() || isLinkedParent(userId);
        allow create: if isOwner(userId);
        allow update: if false;
        allow delete: if isAdmin();
      }
      match /trainingDays/{trainingId} {
        function twoDigits(value) {
          return (value < 10 ? '0' : '') + string(value);
        }
        function sundayOnOrAfter(year, month, day) {
          let start = timestamp.date(year, month, day);
          // 1970-01-04 was a Sunday.
          let offset = (start.toMillis() - 259200000) % 604800000;
          return start + duration.value((604800000 - offset) % 604800000, 'ms');
        }
        function familyDate() {
          let year = request.time.year();
          let summerStart = sundayOnOrAfter(year, 3, 8) + duration.value(10, 'h');
          let summerEnd = sundayOnOrAfter(year, 11, 1) + duration.value(9, 'h');
          let local = request.time - duration.value(request.time >= summerStart
            && request.time < summerEnd ? 7 : 8, 'h');
          return string(local.year()) + '-' + twoDigits(local.month()) + '-' + twoDigits(local.day());
        }
        function validTrainingSession(data) {
          let path = /databases/$(database)/documents/users/$(userId)/attempts/$(data.lastSessionId);
          let session = getAfter(path).data;
          return data.lastSessionId.matches('[A-Za-z0-9_-]{1,150}')
            && session.type == 'subject-practice'
            && session.day == data.day
            && session.subject == data.subject
            && session.score == data.lastScore
            && session.total == 5
            && session.answers.size() == 5
            && session.completedAt == request.time;
        }
        function validTrainingData(data) {
          return data.keys().hasOnly(['day', 'subject', 'attemptCount', 'bestScore', 'lastScore', 'rewardGranted', 'lastSessionId', 'updatedAt'])
            && data.day is string && data.day == familyDate()
            && data.subject in ['math', 'english', 'chinese']
            && trainingId == data.day + '_' + data.subject
            && data.attemptCount is int && data.attemptCount >= 1
            && data.bestScore is int && data.bestScore >= data.lastScore && data.bestScore <= 5
            && data.lastScore is int && data.lastScore >= 0 && data.lastScore <= 5
            && data.rewardGranted is bool
            && data.lastSessionId is string
            && data.updatedAt == request.time
            && validTrainingSession(data);
        }
        allow read: if isOwner(userId) || isAdmin() || isLinkedParent(userId);
        allow create: if isOwner(userId)
          && validTrainingData(request.resource.data)
          && request.resource.data.attemptCount == 1
          && request.resource.data.bestScore == request.resource.data.lastScore
          && request.resource.data.rewardGranted == (request.resource.data.lastScore >= 4)
          && getAfter(/databases/$(database)/documents/users/$(userId)/attempts/$(request.resource.data.lastSessionId)).data.rewardGranted == request.resource.data.rewardGranted;
        allow update: if isOwner(userId)
          && validTrainingData(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attemptCount', 'bestScore', 'lastScore', 'rewardGranted', 'lastSessionId', 'updatedAt'])
          && request.resource.data.day == resource.data.day
          && request.resource.data.subject == resource.data.subject
          && request.resource.data.attemptCount == resource.data.attemptCount + 1
          && request.resource.data.bestScore == (request.resource.data.lastScore > resource.data.bestScore
            ? request.resource.data.lastScore : resource.data.bestScore)
          && request.resource.data.rewardGranted == (resource.data.rewardGranted || request.resource.data.lastScore >= 4)
          && getAfter(/databases/$(database)/documents/users/$(userId)/attempts/$(request.resource.data.lastSessionId)).data.rewardGranted == (request.resource.data.lastScore >= 4 && !resource.data.rewardGranted);
        allow delete: if isAdmin();
      }
      match /parentActivities/{activityDoc} {
        allow read: if isOwner(userId) || isAdmin() || isLinkedParent(userId);
        allow create, update, delete: if isAdmin() || isLinkedParent(userId);
      }
      match /activityCheckins/{checkinId} {
        function twoDigits(value) {
          return (value < 10 ? '0' : '') + string(value);
        }
        function sundayOnOrAfter(year, month, day) {
          let start = timestamp.date(year, month, day);
          // 1970-01-04 was a Sunday.
          let offset = (start.toMillis() - 259200000) % 604800000;
          return start + duration.value((604800000 - offset) % 604800000, 'ms');
        }
        function familyDate() {
          let year = request.time.year();
          let summerStart = sundayOnOrAfter(year, 3, 8) + duration.value(10, 'h');
          let summerEnd = sundayOnOrAfter(year, 11, 1) + duration.value(9, 'h');
          let local = request.time - duration.value(request.time >= summerStart
            && request.time < summerEnd ? 7 : 8, 'h');
          return string(local.year()) + '-' + twoDigits(local.month()) + '-' + twoDigits(local.day());
        }
        function validActivity(data) {
          let plan = get(/databases/$(database)/documents/users/$(userId)/parentActivities/current).data;
          let link = get(/databases/$(database)/documents/parentLinks/$(userId)).data;
          return link.status == 'approved' && link.parentId == plan.parentId
            && data.activityIndex is int && data.activityIndex >= 0 && data.activityIndex < plan.items.size()
            && plan.items[data.activityIndex].id == data.activityId
            && plan.items[data.activityIndex].title == data.title;
        }
        allow read: if isOwner(userId) || isAdmin() || isLinkedParent(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['activityId', 'activityIndex', 'title', 'date', 'status', 'rewardVersion', 'submittedAt'])
          && request.resource.data.date == familyDate()
          && request.resource.data.activityId.matches('[a-zA-Z0-9_-]{1,160}')
          && checkinId == request.resource.data.date + '_' + request.resource.data.activityId
          && request.resource.data.status == 'pending' && request.resource.data.rewardVersion == 2
          && request.resource.data.submittedAt == request.time
          && validActivity(request.resource.data);
        allow update: if isLinkedParent(userId)
          && resource.data.status == 'pending' && resource.data.rewardVersion == 2
          && request.time < resource.data.submittedAt + duration.value(7, 'd')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.resolvedAt == request.time;
        allow delete: if false;
      }
    }

    match /gameSettings/current {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /dragonAssignments/{speciesId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // A parent gets one permanent choice. The choice and unique dragon claim
    // must be created together in one Firestore transaction.
    match /parentDragonChoices/{parentId} {
      allow read: if signedIn();
      allow create: if isParent() && request.auth.uid == parentId
        && request.resource.data.keys().hasOnly(['parentId', 'dragonId', 'selectedAt'])
        && request.resource.data.parentId == parentId
        && isParentDragonId(request.resource.data.dragonId)
        && request.resource.data.selectedAt == request.time
        && !exists(/databases/$(database)/documents/parentDragonChoices/$(parentId))
        && !exists(/databases/$(database)/documents/parentDragonAssignments/$(request.resource.data.dragonId))
        && getAfter(/databases/$(database)/documents/parentDragonAssignments/$(request.resource.data.dragonId)).data.parentId == parentId
        && getAfter(/databases/$(database)/documents/parentDragonAssignments/$(request.resource.data.dragonId)).data.dragonId == request.resource.data.dragonId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /parentDragonAssignments/{dragonId} {
      allow read: if signedIn();
      allow create: if isParent() && isParentDragonId(dragonId)
        && request.resource.data.keys().hasOnly(['parentId', 'dragonId', 'assignedAt'])
        && request.resource.data.parentId == request.auth.uid
        && request.resource.data.dragonId == dragonId
        && request.resource.data.assignedAt == request.time
        && !exists(/databases/$(database)/documents/parentDragonAssignments/$(dragonId))
        && !exists(/databases/$(database)/documents/parentDragonChoices/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/parentDragonChoices/$(request.auth.uid)).data.parentId == request.auth.uid
        && getAfter(/databases/$(database)/documents/parentDragonChoices/$(request.auth.uid)).data.dragonId == dragonId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /parentLinks/{childId} {
      allow get: if isAdmin() || isParent()
        || (isOwner(childId) && resource.data.status == 'approved');
      allow list: if isAdmin() || (isParent() && resource.data.parentId == request.auth.uid);
      // 家长发起申请时暂时占用该儿童；管理员批准或拒绝后再更新或释放。
      allow create: if isAdmin() || (isParent()
        && request.resource.data.parentId == request.auth.uid
        && request.resource.data.childId == childId
        && request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    match /parentRequests/{requestId} {
      allow read: if isAdmin() || (isParent() && resource.data.parentId == request.auth.uid);
      allow create: if isParent()
        && request.resource.data.parentId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
